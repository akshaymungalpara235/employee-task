<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to fetch employee data from the remote JSON API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EmployeeDirectoryApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmployeeDirectory">

        <activity
            android:name=".presentation.employeedirectory.list.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EmployeeDirectory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.employeedirectory.detail.EmployeeDetailActivity"
            android:exported="false"
            android:parentActivityName=".presentation.employeedirectory.list.MainActivity"
            android:theme="@style/Theme.EmployeeDirectory" />

    </application>

</manifest>
